# 数据库配置
DB_USERNAME=root
DB_PASSWORD=root

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# PostgreSQL 配置
PG_USERNAME=postgres
PG_PASSWORD=postgres

# JWT 配置（生产环境请务必替换为强随机密钥，至少 32 字节）
JWT_SECRET=your-jwt-secret-key-here

# Docker 端口映射
# 前端 Nginx 对外端口（默认 80）
APP_PORT=80
# 后端直连端口（默认 8080，可通过它访问 Swagger）
BACKEND_PORT=8080

# RabbitMQ 配置（预留）
# RABBITMQ_USER=guest
# RABBITMQ_PASSWORD=guest
