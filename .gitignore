# ================================================================
# AForum 项目 .gitignore
#
# 【跟踪】源码 + 构建/运行配置 + 密钥模板 + 依赖锁定
#   - 源码：            src/、frontend/src/、frontend/public/
#   - 构建/运行配置：   pom.xml、mvnw、vite.config.ts、Dockerfile、
#                       docker-compose.yml、nginx.conf 等
#   - 密钥模板：        .env.example（仅模板，不含真实密钥）
#   - 依赖锁定：        frontend/package-lock.json
#
# 【不跟踪】构建产物 + 本地环境/密钥 + IDE 残留 + 日志 + 运行时产物
# ================================================================

# ---------- 构建产物 ----------
target/
frontend/dist/
frontend/node_modules/
*.class
*.jar
*.war

# ---------- Maven Wrapper（jar 可由 Maven 自动下载，不入库） ----------
.mvn/wrapper/maven-wrapper.jar

# ---------- 环境变量与密钥（.env.example 保留入库） ----------
.env
.env.*
!.env.example

# ---------- 日志 ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---------- 运行时 / 临时目录 ----------
/output/
/temp_images/

# ---------- IDE / 编辑器 ----------
.idea/
*.iml
*.iws
*.ipr
.vscode/

# ---------- 系统 / OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 工具 / 个人目录 ----------
.claude/
.workbuddy/

# ---------- 文档（不入库） ----------
/docs/
HELP.md

# ---------- 本地计划草稿（不入库） ----------
/temp_plan/
